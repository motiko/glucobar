<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud Keychain for secrets. Only valid together with the provisioning profile in
	     Config/, so it is applied by Local.xcconfig / release.sh, never to ad-hoc builds. -->
	<key>com.apple.application-identifier</key>
	<string>RWNFPY7RQK.dev.moti.glucobar</string>
	<key>com.apple.developer.team-identifier</key>
	<string>RWNFPY7RQK</string>
	<key>keychain-access-groups</key>
	<array>
		<string>RWNFPY7RQK.dev.moti.glucobar</string>
	</array>
</dict>
</plist>
