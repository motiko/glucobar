// Code signing. Default: ad-hoc, which needs no certificate but gives every build a new
// identity, so macOS asks for Keychain access again after each rebuild, and secrets stay in
// this Mac's login keychain instead of iCloud Keychain.
//
// To sign with your own certificate (Keychain "Always Allow" then survives rebuilds),
// create Config/Local.xcconfig (gitignored) containing:
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = <your team id>
//
// To also keep secrets in iCloud Keychain (team RWNFPY7RQK only), sign like a release:
//   CODE_SIGN_IDENTITY = Developer ID Application
//   DEVELOPMENT_TEAM = RWNFPY7RQK
//   PROVISIONING_PROFILE_SPECIFIER = ce468c00-52a0-4640-b65a-a6035bb166c7
//   CODE_SIGN_ENTITLEMENTS = App/GlucoBar.entitlements
// and install the profile once:
//   cp Config/GlucoBar_Developer_ID.provisionprofile \
//     ~/Library/Developer/Xcode/UserData/Provisioning\ Profiles/ce468c00-52a0-4640-b65a-a6035bb166c7.provisionprofile
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
#include? "Local.xcconfig"
